{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fung.es/schemas/species-manifest-v1.json",
  "title": "Fung.es species manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scientificName",
    "catalog",
    "locales",
    "identification",
    "forecast"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
    "scientificName": { "type": "string", "minLength": 2 },
    "scientificNameGroup": { "type": "string", "minLength": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "order",
        "translationKey",
        "category",
        "emoji",
        "season",
        "habitat",
        "image"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "routeToDish": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "translationKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "category": { "enum": ["mushroom", "plant", "berry", "nut", "flower"] },
        "emoji": { "type": "string", "minLength": 1 },
        "season": { "type": "string", "minLength": 1 },
        "habitat": { "type": "string", "minLength": 1 },
        "psychoactive": {
          "const": true,
          "description": "Not food: a psychoactive species. Badge, a Medicine section in place of Cooking, no recipes."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^src/assets/species/.+\\.webp$"
            },
            "source": { "type": "string" },
            "author": { "type": "string" },
            "license": { "type": "string" }
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "required": ["en", "it", "fr", "de", "es", "pt"],
      "additionalProperties": false,
      "patternProperties": {
        "^(en|it|fr|de|es|pt)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "howTo"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "howTo": { "type": "string", "minLength": 1 },
            "guide": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identify",
                "habitat",
                "season",
                "picking",
                "kitchen",
                "source"
              ],
              "properties": {
                "identify": { "type": "string", "minLength": 1 },
                "habitat": { "type": "string", "minLength": 1 },
                "season": { "type": "string", "minLength": 1 },
                "picking": { "type": "string", "minLength": 1 },
                "kitchen": { "type": "string", "minLength": 1 },
                "keeps": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "identification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 2 },
        "rank": { "enum": ["species", "genus"] },
        "safetyReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "references"],
          "properties": {
            "status": { "enum": ["pending", "approved"] },
            "reviewedBy": { "type": "string" },
            "references": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["label", "rank", "safetyReview"] }
        }
      ]
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "compositeOf": {
          "description": "Scored as the best of these forecast species at each place and day; its regions then take no land cover or scoring of their own",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dataColumns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "empiricalSeason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "taxonKeys", "references"],
          "properties": {
            "enabled": { "type": "boolean" },
            "taxonKeys": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            },
            "references": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rangePrior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taxonKeys"],
          "properties": {
            "taxonKeys": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "regions": {
          "type": "object",
          "required": ["NE", "SE", "USE", "USW", "ANZ"],
          "propertyNames": { "enum": ["NE", "SE", "USE", "USW", "ANZ"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["available"],
            "properties": {
              "available": { "type": "boolean" },
              "landCover": {
                "type": "array",
                "minItems": 1,
                "items": { "type": ["integer", "string"] }
              },
              "landCoverScheme": { "enum": ["CORINE", "NLCD", "ANZ"] },
              "scoringReferences": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "scoringSnapshotSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "without": {
                "description": "A composite's members it leaves out in this region (only on composites).",
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "available": { "const": true } },
                  "required": ["available"]
                },
                "then": {
                  "required": [
                    "landCover",
                    "landCoverScheme",
                    "scoringReferences"
                  ]
                },
                "else": {
                  "properties": {
                    "landCover": false,
                    "landCoverScheme": false,
                    "scoringReferences": false,
                    "scoringSnapshotSha256": false
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "required": [
              "regions",
              "empiricalSeason",
              "rangePrior",
              "routeToDish"
            ]
          }
        }
      ]
    }
  }
}
