  "locales": {
    "en": {
      "name": "Wild mints",
      "description": "Any wild mint: water mint, horse mint, apple mint, corn mint and pennyroyal. Square stems, opposite leaves and a mint scent when crushed",
      "howTo": "Found in damp ground, ditches and along streams. Pennyroyal is fine as a light tea (poleo menta) but toxic as an oil or in quantity: avoid it in pregnancy"
    },
    "it": {
      "name": "Mente selvatiche",
      "description": "Qualsiasi menta selvatica: menta acquatica, mentastro verde, menta a foglie rotonde, menta campestre e menta puleggio. Fusti quadrati, foglie opposte e profumo di menta quando si strofinano",
      "howTo": "Cresce su terreni umidi, nei fossi e lungo i ruscelli. La menta puleggio va bene in una tisana leggera, ma è tossica come olio o in grandi quantità: da evitare in gravidanza"
    },
    "fr": {
      "name": "Menthes sauvages",
      "description": "Toute menthe sauvage : menthe aquatique, menthe à longues feuilles, menthe à feuilles rondes, menthe des champs et menthe pouliot. Tiges carrées, feuilles opposées et odeur de menthe quand on les froisse",
      "howTo": "Se trouve sur les sols humides, dans les fossés et au bord des ruisseaux. La menthe pouliot convient en tisane légère, mais elle est toxique en huile ou en grande quantité : à éviter pendant la grossesse"
    },
    "de": {
      "name": "Wilde Minzen",
      "description": "Jede wilde Minze: Wasserminze, Rossminze, Apfelminze, Ackerminze und Polei-Minze. Vierkantige Stängel, gegenständige Blätter und Minzduft beim Zerreiben",
      "howTo": "Zu finden auf feuchten Böden, in Gräben und an Bächen. Polei-Minze ist als leichter Tee unbedenklich, als Öl oder in grösseren Mengen aber giftig: in der Schwangerschaft meiden"
    },
    "es": {
      "name": "Mentas silvestres",
      "description": "Cualquier menta silvestre: menta acuática, menta de caballo, mastranzo, menta de campo y poleo. Tallos cuadrados, hojas opuestas y aroma a menta al frotarlas",
      "howTo": "Crece en suelos húmedos, acequias y a lo largo de arroyos. El poleo está bien en una infusión ligera (poleo menta), pero es tóxico como aceite o en cantidad: evítalo en el embarazo"
    },
    "pt": {
      "name": "Hortelãs-selvagens",
      "description": "Qualquer hortelã silvestre: hortelã-da-água, hortelã-brava, mentrasto, hortelã-do-campo e poejo. Caules quadrados, folhas opostas e cheiro a menta quando esmagadas",
      "howTo": "Encontra-se em terrenos húmidos, valas e ao longo de ribeiros. O poejo pode ser usado num chá leve, mas é tóxico como óleo ou em quantidade: evitar na gravidez"
    }
  },
