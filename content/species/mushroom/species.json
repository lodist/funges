    },
    "fr": {
      "name": "Boletus",
      "description": "Aussi appelé cèpe de Bordeaux, ce champignon prisé a un chapeau brun et des pores blancs ou jaunes",
      "howTo": "Se trouve dans les forêts de conifères et de feuillus, souvent près des pins"
    },
    "de": {
      "name": "Boletus",
      "description": "Auch als Herrenpilz bekannt, geschätzter Pilz mit braunem Hut und weissen oder gelben Röhren",
      "howTo": "Kommt in Nadel- und Laubwäldern vor, oft in der Nähe von Kiefern"
    },
    "es": {
      "name": "Boletus",
      "description": "También conocido como hongo rey, este apreciado hongo tiene un sombrero marrón y poros blancos o amarillos",
      "howTo": "Se encuentra en bosques de coníferas y caducifolios, a menudo cerca de pinos"
    },
    "pt": {
      "name": "Boletus",
      "description": "Também conhecido como Boleto, este cogumelo valorizado tem chapéu marrom e poros brancos ou amarelos",
      "howTo": "Encontrado em florestas de coníferas e decíduas, frequentemente perto de pinheiros"
    }
