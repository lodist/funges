    "en": {
      "name": "Porcini",
      "description": "The king bolete: a stout brown-capped mushroom with a pale netted stem and white pores that never bruise blue",
      "howTo": "Found in coniferous and deciduous forest, often near spruce and beech, from late summer into autumn"
    },
    "it": {
      "name": "Porcino",
      "description": "Il porcino per eccellenza: cappello bruno, gambo tozzo e reticolato, pori bianchi che non virano al blu",
      "howTo": "Si trova nelle foreste di conifere e latifoglie, spesso vicino ad abeti e faggi, da fine estate all'autunno"
    },
    "fr": {
      "name": "Cèpe de Bordeaux",
      "description": "Le roi des cèpes : chapeau brun, pied trapu et réticulé, pores blancs qui ne bleuissent jamais",
      "howTo": "Se trouve dans les forêts de conifères et de feuillus, souvent près des épicéas et des hêtres, de la fin de l'été à l'automne"
    },
    "de": {
      "name": "Steinpilz",
      "description": "Der Herrenpilz: brauner Hut, gedrungener genetzter Stiel und weisse Röhren, die sich nie blau verfärben",
      "howTo": "Kommt in Nadel- und Laubwäldern vor, oft bei Fichten und Buchen, vom Spätsommer bis in den Herbst"
    },
    "es": {
      "name": "Boleto Comestible",
      "description": "El rey de los boletos: sombrero pardo, pie robusto y reticulado, y poros blancos que nunca azulean",
      "howTo": "Se encuentra en bosques de coníferas y caducifolios, a menudo cerca de abetos y hayas, de finales de verano al otoño"
    },
    "pt": {
      "name": "Boleto Comestível",
      "description": "O rei dos boletos: chapéu castanho, pé robusto e reticulado, e poros brancos que nunca azulam",
      "howTo": "Encontrado em florestas de coníferas e decíduas, muitas vezes perto de abetos e faias, do fim do verão ao outono"
    }
  },
