# Local zone-curve build artifacts (authoritative copies live in R2)
/*_zone_season_curves.json
# rolling-forecast subset proof output (generated)
tests/subset_master_*.parquet

# forecast-vs-actual longitudinal snapshot (generated)
tests/forecast_vs_actual_snapshot.jsonl

# Brainstorming session scratch (mockups/state, not project artifacts)
.superpowers/

# BioCLIP spike cache (downloaded photos + embeddings)
spike_cache/

# Generated regional PMTiles can be hundreds of megabytes; publish to R2.
dist-offline/

# ONNX export artifacts (the shipped model lives on R2, not in git)
backend/tools/model_artifacts/

# Built and fitted files live on R2 (backend/r2.py downloads them on use); only
# what the site reads and the pointer files stay in git.
backend/generated/*
!backend/generated/on_r2.json
!backend/generated/species_registry.json
!backend/generated/habitat_factor.json
!backend/generated/local_season.json
!backend/generated/phenology.json


# Playwright failure artifacts
test-results/
playwright-report/

# ~/.gitignore (global excludesFile) blanket-ignores CONTEXT.md and docs/*
# for other projects' scratch/Claude-generated files. Findings (QA reports,
# calibration notes, specs and plans) live in the private lodist/funges-lab repo,
# so docs/* stays ignored; the docs that are tracked (adr, agents) were force-added.
CONTEXT.md
docs/*
.claude/
!.claude/skills/
!.claude/skills/**
.agents/
!.agents/skills/
!.agents/skills/**

.serena/


# Private: lives on R2 (scores/), CI fetches it with backend/r2.py
public/data/foraging_scores.parquet
